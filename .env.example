PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_ai?schema=public"

# Auth JWT
JWT_SECRET="dev_jwt_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="dev_refresh_secret_change_in_production_min_32_chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# LLM Gateway
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="dev-key"
LLM_MODEL="hermes-3-llama-3.1-8b"
