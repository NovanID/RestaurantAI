PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant_ai?schema=public"

# Auth JWT
JWT_SECRET="dev_jwt_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="dev_refresh_secret_change_in_production_min_32_chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# OpenRouter
# Configure matching names in ignored apps/backend/.env. Never commit real keys.
OPENROUTER_API_KEY="replace_with_your_local_key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="AI-Powered Restaurant"
LLM_TOOL_MODEL="replace_with_tool_calling_model_slug"
LLM_DEFAULT_MODEL="replace_with_default_model_slug"
