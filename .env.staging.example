# Staging Environment Configuration Template

# Database
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_password_staging_secure
POSTGRES_DB=restaurant_ai_staging
POSTGRES_PORT=5432
DATABASE_URL=postgresql://restaurant_user:restaurant_password_staging_secure@postgres:5432/restaurant_ai_staging?schema=public

# Backend Auth & Security
# Mandatory: min 32 chars
JWT_SECRET=super_secret_staging_jwt_key_restaurant_ai_2026_min32chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenRouter / LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_TOOL_MODEL=google/gemini-2.0-flash-001
LLM_DEFAULT_MODEL=google/gemini-2.0-flash-001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
