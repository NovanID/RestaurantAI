# Copy to an ignored .env.staging file. Never commit a populated file.
POSTGRES_USER=restaurant_ai
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=restaurant_ai_staging
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=https://staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com/api/v1
LLM_BASE_URL=https://llm-gateway.example.com/v1
LLM_API_KEY=replace-with-provider-secret
LLM_MODEL=your-approved-model
BACKEND_PORT=4000
FRONTEND_PORT=3000
